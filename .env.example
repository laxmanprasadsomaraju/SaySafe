# ---- PayPal (sandbox) ----
# developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# or one variable: PAYPAL_CREDENTIALS=CLIENT_ID:SECRET
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# developer.paypal.com -> your app -> Webhooks -> Add webhook (URL: https://YOUR-APP/api/paypal/webhook)
# Events: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED
PAYPAL_WEBHOOK_ID=

# ---- AI (Groq, primary) ----  https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides (defaults shown). Check https://console.groq.com/docs/models
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_STT_MODEL=whisper-large-v3-turbo

# ---- AI fallback (optional, any OpenAI-compatible endpoint, e.g. Gemini) ----
# AI_FALLBACK_NAME=gemini
# AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_TEXT_MODEL=gemini-2.5-flash

# ---- Real product discovery (Channel3) ----  https://trychannel3.com/dashboard -> API keys
# Discovery only: results link to the retailer. SaySafe never completes a retailer purchase.
CHANNEL3_API_KEY=

# ---- Threat intelligence (optional) ----
# GOOGLE_WEB_RISK_API_KEY=
# PHISHTANK_APP_KEY=

# ---- Family Safety Insights (docs/AG-STUDIO.md) ----
# FEATURE_INSIGHTS=on              # off hides the insights dashboard and its endpoints
INSIGHTS_DASHBOARD=native          # native (default, public) | agstudio (local / recorded demo only)
# AG Studio licence: build-time only, set as a Render/shell env var. NEVER commit a key here.
VITE_AG_STUDIO_LICENSE=
# VITE_AG_STUDIO_LOCAL_EVAL=1      # local machine only: show the AG Studio view unlicensed (AG watermark) for a demo

# ---- App ----
PORT=8787
# PUBLIC_URL=https://saysafe.onrender.com
# DATABASE_FILE=data/saysafe.db   # local SQLite, used when TURSO_DATABASE_URL is unset (dev/tests)

# ---- Persistent database (Turso, free plan) ----  see docs/DATABASE.md
# Required when NODE_ENV=production (the server refuses to start on an ephemeral file otherwise).
# TURSO_DATABASE_URL=libsql://YOUR-DB-YOUR-ORG.turso.io
# TURSO_AUTH_TOKEN=
# TURSO_MODE=remote            # optional: skip the embedded replica, send every query to Turso
# TURSO_SYNC_INTERVAL=60       # optional: background replica sync, seconds
# SAYSAFE_ALLOW_EPHEMERAL_DB=true   # explicit opt-in to run production on a throwaway local file
