{
  "name": "SaySafe — Shop simply. Pay safely.",
  "short_name": "SaySafe",
  "description": "Check a message for scam warning signs, shop by voice, and pay with family approval.",
  "id": "/",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F7F8F4",
  "theme_color": "#087D70",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/check/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
